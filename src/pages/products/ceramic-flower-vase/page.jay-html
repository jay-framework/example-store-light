<html>

<head>
  <script type="application/jay-headless" plugin="@jay-framework/wix-stores" contract="product-page"
    key="productPage">slug: ceramic-flower-vase</script>
  <script type="application/jay-headless" plugin="@jay-framework/wix-cart"
    contract="cart-indicator"></script>
  <script type="application/jay-headless"
    contract="../../../components/site-header/site-header.jay-contract"
    template="../../../components/site-header/site-header.jay-html"></script>
  <title>Ceramic Flower Vase — Atelier</title>
  <meta name="description"
    content="Explore our handcrafted ceramic flower vase, designed for beauty and everyday elegance.">
  <script type="application/jay-data">
      data:
    </script>
  <link rel="stylesheet" href="../../../styles/atelier-theme.css">
  <style>
    /* ===================================================== CERAMIC FLOWER VASE - SPECIAL EDITORIAL LAYOUT Full-size images in vertical scroll, immersive experience ===================================================== */
    .vase-page {
      min-height: 100vh;
      background: var(--bg-primary);
    }

    /* Hero Image - Full Viewport */
    .hero-image-section {
      position: relative;
      height: 85vh;
      min-height: 600px;
      overflow: hidden;
      background: var(--bg-secondary);
    }

    .hero-image-section img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .hero-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 80px var(--page-padding) 60px;
      background: linear-gradient(to top, rgba(45, 42, 38, 0.85), transparent);
      color: var(--text-inverse);
    }

    .hero-badges {
      display: flex;
      gap: 12px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .hero-brand {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      opacity: 0.8;
      margin-bottom: 12px;
    }

    .hero-title {
      font-family: var(--font-serif);
      font-size: clamp(36px, 6vw, 64px);
      font-weight: 500;
      line-height: 1.1;
      margin-bottom: 20px;
      max-width: 700px;
    }

    .hero-price {
      display: flex;
      align-items: baseline;
      gap: 16px;
    }

    .hero-price .main-price {
      font-size: 32px;
      font-weight: 600;
    }

    .hero-price .was-price {
      font-size: 20px;
      opacity: 0.7;
      text-decoration: line-through;
    }

    /* Product Info Section */
    .product-info-section {
      max-width: 800px;
      margin: 0 auto;
      padding: 64px var(--page-padding);
    }

    .product-meta {
      display: flex;
      align-items: center;
      gap: 24px;
      margin-bottom: 40px;
      flex-wrap: wrap;
    }

    .product-sku-tag {
      font-size: 12px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .stock-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      border-radius: var(--radius-full);
      font-size: 13px;
      font-weight: 600;
    }

    .stock-pill.available {
      background: var(--success-bg);
      color: var(--success);
    }

    .stock-pill.sold-out {
      background: var(--error-bg);
      color: var(--error);
    }

    .stock-pill .pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: currentColor;
      animation: pulse-glow 2s infinite;
    }

    @keyframes pulse-glow {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0.4;
      }
    }

    .description-block {
      font-size: 18px;
      line-height: 1.8;
      color: var(--text-secondary);
      margin-bottom: 48px;
      padding: 32px;
      background: var(--bg-secondary);
      border-radius: var(--radius-xl);
      border-left: 4px solid var(--accent);
    }

    /* Options Section */
    .options-section {
      margin-bottom: 48px;
    }

    .option-block {
      margin-bottom: 32px;
    }

    .option-title {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-primary);
      margin-bottom: 16px;
    }

    .option-choices-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    /* Quantity and Actions - Sticky on Scroll */
    .actions-section {
      position: sticky;
      bottom: 0;
      background: var(--bg-card);
      border-top: 1px solid var(--border);
      padding: 20px var(--page-padding);
      box-shadow: 0 -8px 32px rgba(45, 42, 38, 0.1);
      z-index: 100;
    }

    .actions-inner {
      max-width: 800px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .actions-price {
      margin-right: auto;
    }

    .actions-price .label {
      display: block;
      margin-bottom: 4px;
    }

    .actions-price .amount {
      font-size: 28px;
      font-weight: 700;
      color: var(--accent);
    }

    .actions-buttons {
      display: flex;
      gap: 12px;
    }

    .actions-buttons .btn {
      min-width: 160px;
    }

    /* Full-Width Image Gallery - All Images Large */
    .image-gallery {
      background: var(--bg-secondary);
      padding: 80px 0;
    }

    .gallery-header {
      max-width: 800px;
      margin: 0 auto 48px;
      padding: 0 var(--page-padding);
      text-align: center;
    }

    .gallery-header h2 {
      font-family: var(--font-serif);
      font-size: 28px;
      font-weight: 500;
      color: var(--text-primary);
      margin-bottom: 12px;
    }

    .gallery-header p {
      color: var(--text-secondary);
      font-size: 16px;
    }

    /* All images shown in full size, vertically stacked */
    .gallery-images {
      display: flex;
      flex-direction: column;
      gap: 40px;
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 var(--page-padding);
    }

    .gallery-image-item {
      border-radius: var(--radius-2xl);
      overflow: hidden;
      box-shadow: var(--shadow-xl);
      background: var(--bg-card);
      cursor: pointer;
      transition: transform var(--transition-slow), box-shadow var(--transition-slow);
    }

    .gallery-image-item:hover {
      transform: scale(1.01);
      box-shadow: 0 32px 64px rgba(45, 42, 38, 0.15);
    }

    .gallery-image-item img {
      width: 100%;
      height: auto;
      display: block;
    }

    .gallery-image-caption {
      padding: 20px 24px;
      font-size: 14px;
      color: var(--text-secondary);
      text-align: center;
      background: var(--bg-card);
      border-top: 1px solid var(--border);
    }

    /* Additional Info Accordion */
    .info-accordion {
      max-width: 800px;
      margin: 0 auto;
      padding: 64px var(--page-padding);
    }

    .accordion-item {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      margin-bottom: 12px;
      overflow: hidden;
    }

    .accordion-header {
      padding: 20px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      transition: background var(--transition-fast);
    }

    .accordion-header:hover {
      background: var(--bg-hover);
    }

    .accordion-title {
      font-family: var(--font-serif);
      font-size: 16px;
      font-weight: 500;
      color: var(--text-primary);
    }

    .accordion-icon {
      font-size: 20px;
      color: var(--text-muted);
    }

    .accordion-content {
      padding: 0 24px 24px;
      font-size: 15px;
      line-height: 1.75;
      color: var(--text-secondary);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .hero-image-section {
        height: 70vh;
        min-height: 500px;
      }

      .hero-overlay {
        padding: 60px var(--page-padding) 40px;
      }

      .hero-title {
        font-size: 32px;
      }

      .actions-inner {
        flex-direction: column;
        gap: 16px;
      }

      .actions-price {
        margin-right: 0;
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .actions-buttons {
        width: 100%;
      }

      .actions-buttons .btn {
        flex: 1;
        min-width: auto;
      }

      .gallery-images {
        gap: 24px;
      }
    }

    @scope (.siteHeader) {
      :scope {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px var(--page-padding);
        background: var(--bg-card);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(12px);
        background: rgba(255, 255, 255, 0.92);
      }

      .site-logo {
        font-family: var(--font-serif);
        font-size: 26px;
        font-weight: 500;
        color: var(--text-primary);
        letter-spacing: -0.02em;
      }

      .site-logo span {
        color: var(--accent);
      }

      .site-nav {
        display: flex;
        align-items: center;
        gap: 32px;
      }

      .site-nav a {
        color: var(--text-secondary);
        font-size: 14px;
        font-weight: 500;
        transition: color var(--transition-fast);
        letter-spacing: 0.02em;
      }

      .site-nav a:hover {
        color: var(--text-primary);
      }

      /* Cart Indicator */
      .cart-indicator {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 20px;
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        color: var(--text-primary);
        font-size: 14px;
        font-weight: 500;
        transition: all var(--transition-fast);
        text-decoration: none;
      }

      .cart-indicator:hover {
        border-color: var(--accent);
        color: var(--text-primary);
        background: var(--bg-card);
      }

      .cart-indicator-icon {
        font-size: 18px;
      }

      .cart-indicator-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 22px;
        padding: 0 7px;
        background: var(--accent);
        border-radius: var(--radius-full);
        font-size: 11px;
        font-weight: 700;
        color: var(--text-inverse);
      }

      /* Just added animation */
      .cart-indicator.just-added {
        animation: cart-bounce 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      @keyframes cart-bounce {

        0%,
        100% {
          transform: scale(1);
        }

        50% {
          transform: scale(1.08);
          border-color: var(--accent);
        }
      }

      .cart-indicator.is-loading .cart-indicator-count {
        opacity: 0.5;
      }

      .cart-indicator-active {
        border-color: var(--accent);
        background: var(--accent-lighter);
      }

      @media (max-width: 600px) {
        :scope {
          padding: 16px var(--page-padding);
        }

        .site-nav {
          gap: 16px;
        }
      }
    }
  </style>
</head>

<body>
  <main class="vase-page"><jay:site-header ref="siteHeader">
      <header class="site-header siteHeader"><a href="/products"
          class="site-logo">Atelier<span>.</span></a>
        <nav class="site-nav"><a href="/products">Collection</a><jay:cart-indicator><a href="/cart"
              class="cart-indicator {hasItems ? has-items} {isLoading ? is-loading} {justAdded ? just-added}"
              ref="cartLink"><span class="cart-indicator-icon">🛒</span><span
                class="cart-indicator-count"
                if="hasItems">{itemCount}</span></a></jay:cart-indicator></nav>
      </header>
    </jay:site-header>
    <section class="hero-image-section"><img
        src="{productPage.mediaGallery.selectedMedia.url}/v1/fill/w_1920,h_1080/file.webp"
        srcset="{productPage.mediaGallery.selectedMedia.url}/v1/fill/w_600%2Ch_338/file.webp 600w, {productPage.mediaGallery.selectedMedia.url}/v1/fill/w_1200%2Ch_675/file.webp 1200w, {productPage.mediaGallery.selectedMedia.url}/v1/fill/w_1920%2Ch_1080/file.webp 1920w"
        sizes="100vw" alt="{productPage.productName}" loading="eager" width="1920" height="1080"
        fetchpriority="high">
      <div class="hero-overlay">
        <div class="hero-badges">
          <div class="badge badge-accent" if="productPage.ribbon">{productPage.ribbon}</div>
          <div class="product-type-badge physical" if="productPage.productType == PHYSICAL">📦
            Handcrafted</div>
        </div>
        <div class="hero-brand" if="productPage.brand">{productPage.brand}</div>
        <h1 class="hero-title">{productPage.productName}</h1>
        <div class="hero-price"><span class="main-price">{productPage.price}</span><span
            class="was-price"
            if="productPage.strikethroughPrice">{productPage.strikethroughPrice}</span></div>
      </div>
    </section>
    <section class="product-info-section">
      <div class="product-meta"><span class="product-sku-tag" if="productPage.sku">SKU:
          {productPage.sku}</span>
        <div class="stock-pill available" if="productPage.stockStatus == IN_STOCK"><span
            class="pulse-dot"></span>Available Now</div>
        <div class="stock-pill sold-out" if="productPage.stockStatus == OUT_OF_STOCK"><span
            class="pulse-dot"></span>Currently Unavailable</div>
      </div>
      <div class="description-block" if="productPage.description">{productPage.description}</div>
      <div class="options-section" if="productPage.options">
        <div class="option-block" forEach="productPage.options" trackBy="_id">
          <div class="option-title" aria-hidden="true">{name}</div><select class="select"
            if="optionRenderType == TEXT_CHOICES" ref="productPage.options.textChoice"
            aria-label="{name}">
            <option forEach="choices" trackBy="choiceId" value="{choiceId}">{name}</option>
          </select>
          <div class="option-choices-grid" if="optionRenderType == COLOR_SWATCH_CHOICES"><button
              class="choice-btn color-swatch {isSelected ? selected} {!inStock ? out-of-stock}"
              style="background-color: {colorCode}" forEach="choices" trackBy="choiceId"
              ref="productPage.options.choices.choiceButton" title="{name}"
              aria-label="{name}"></button></div>
        </div>
      </div>
      <div class="options-section" if="productPage.modifiers">
        <div class="option-block" forEach="productPage.modifiers" trackBy="_id">
          <div class="option-title" aria-hidden="true">{name}</div><select class="select"
            if="modifierType == TEXT_CHOICES" ref="productPage.modifiers.textModifier"
            aria-label="{name}">
            <option forEach="choices" trackBy="choiceId" value="{choiceId}">{name}</option>
          </select><input class="input" type="text" if="modifierType == FREE_TEXT"
            ref="productPage.modifiers.textInput" placeholder="Custom engraving text"
            maxlength="{textInputLength}" aria-label="{name}">
        </div>
      </div>
      <div class="option-block">
        <div class="option-title">Quantity</div>
        <div class="quantity-controls"><button class="quantity-btn"
            ref="productPage.quantity.decrementButton">−</button><input class="quantity-input"
            type="number" value="{productPage.quantity.quantity}"
            ref="productPage.quantity.quantity" min="1" aria-label="Quantity"><button
            class="quantity-btn" ref="productPage.quantity.incrementButton">+</button></div>
      </div>
    </section>
    <section class="image-gallery">
      <div class="gallery-header">
        <h2>Every Angle</h2>
        <p>Explore the craftsmanship in detail</p>
      </div>
      <div class="gallery-images">
        <div class="gallery-image-item" forEach="productPage.mediaGallery.availableMedia"
          trackBy="mediaId" ref="productPage.mediaGallery.availableMedia.selected"><img
            src="{media.url}/v1/fill/w_1000,h_1000/file.webp"
            srcset="{media.url}/v1/fill/w_400%2Ch_400/file.webp 400w, {media.url}/v1/fill/w_700%2Ch_700/file.webp 700w, {media.url}/v1/fill/w_1000%2Ch_1000/file.webp 1000w"
            sizes="(max-width: 768px) 100vw, 1000px" alt="Product image" loading="lazy" width="1000"
            height="1000"></div>
      </div>
    </section>
    <section class="info-accordion" if="productPage.infoSections">
      <div class="accordion-item" forEach="productPage.infoSections" trackBy="_id">
        <div class="accordion-header"><span class="accordion-title">{title}</span><span
            class="accordion-icon">+</span></div>
        <div class="accordion-content">{plainDescription}</div>
      </div>
    </section>
    <div class="actions-section">
      <div class="actions-inner">
        <div class="actions-price"><span class="label">Total</span><span
            class="amount">{productPage.price}</span></div>
        <div class="actions-buttons"><button class="btn btn-secondary btn-lg"
            ref="productPage.buyNowButton" disabled="!productPage.actionsEnabled">Buy
            Now</button><button class="btn btn-primary btn-lg" ref="productPage.addToCartButton"
            disabled="!productPage.actionsEnabled">Add to Cart</button></div>
      </div>
    </div>
  </main>
</body>

</html>