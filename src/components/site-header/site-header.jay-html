<html>
  <head>
    <script type="application/jay-headless" plugin="@jay-framework/wix-cart" contract="cart-indicator"></script>
    <script type="application/jay-data" contract="./site-header.jay-contract"></script>
  </head>
  <body>
    <header class="site-header">
      <a href="/products" class="site-logo">Atelier<span>.</span></a>
      <nav class="site-nav">
        <a href="/products">Collection</a>
        <jay:cart-indicator>
          <a href="/cart"
             class="cart-indicator {hasItems ? has-items} {isLoading ? is-loading} {justAdded ? just-added}"
             ref="cartLink">
            <span class="cart-indicator-icon">🛒</span>
            <span class="cart-indicator-count" if="hasItems">{itemCount}</span>
          </a>
        </jay:cart-indicator>
      </nav>
    </header>
  </body>
  <style>
    .site-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px var(--page-padding);
      background: var(--bg-card);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(12px);
      background: rgba(255, 255, 255, 0.92);
    }

    .site-logo {
      font-family: var(--font-serif);
      font-size: 26px;
      font-weight: 500;
      color: var(--text-primary);
      letter-spacing: -0.02em;
    }

    .site-logo span {
      color: var(--accent);
    }

    .site-nav {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .site-nav a {
      color: var(--text-secondary);
      font-size: 14px;
      font-weight: 500;
      transition: color var(--transition-fast);
      letter-spacing: 0.02em;
    }

    .site-nav a:hover {
      color: var(--text-primary);
    }

    /* Cart Indicator */
    .cart-indicator {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 20px;
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: var(--radius-full);
      color: var(--text-primary);
      font-size: 14px;
      font-weight: 500;
      transition: all var(--transition-fast);
      text-decoration: none;
    }

    .cart-indicator:hover {
      border-color: var(--accent);
      color: var(--text-primary);
      background: var(--bg-card);
    }

    .cart-indicator-icon {
      font-size: 18px;
    }

    .cart-indicator-count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 22px;
      height: 22px;
      padding: 0 7px;
      background: var(--accent);
      border-radius: var(--radius-full);
      font-size: 11px;
      font-weight: 700;
      color: var(--text-inverse);
    }

    /* Just added animation */
    .cart-indicator.just-added {
      animation: cart-bounce 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @keyframes cart-bounce {
      0%,
      100% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.08);
        border-color: var(--accent);
      }
    }

    .cart-indicator.is-loading .cart-indicator-count {
      opacity: 0.5;
    }

    .cart-indicator-active {
      border-color: var(--accent);
      background: var(--accent-lighter);
    }

    @media (max-width: 600px) {
      .site-header {
        padding: 16px var(--page-padding);
      }

      .site-nav {
        gap: 16px;
      }
    }
  </style>
</html>
